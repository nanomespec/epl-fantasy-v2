:root {
  --bg-color: #0f172a;
  --card-bg: #1e293b;
  --accent-color: #10b981;
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --pitch-green: #15803d;
  --pitch-lines: rgba(255, 255, 255, 0.2);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

body {
  background-color: var(--bg-color);
  color: var(--text-main);
  padding-bottom: 20px;
}

/* Header */
.app-header {
  background: var(--card-bg);
  padding: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #334155;
}

.user-profile {
  display: flex;
  align-items: center;
  gap: 10px;
}

.avatar {
  font-size: 24px;
}

.user-meta h3 {
  font-size: 16px;
}

.user-meta p {
  font-size: 12px;
  color: var(--text-muted);
}

.stats-banner {
  display: flex;
  gap: 12px;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.stat-label {
  font-size: 10px;
  color: var(--text-muted);
  text-transform: uppercase;
}

.stat-value {
  font-weight: bold;
  font-size: 14px;
  color: var(--accent-color);
}

/* Navigation */
.nav-tabs {
  display: flex;
  background-color: #0f172a;
  border-bottom: 1px solid #334155;
}

.tab-btn {
  flex: 1;
  padding: 12px 0;
  background: none;
  border: none;
  color: var(--text-muted);
  font-weight: 600;
  cursor: pointer;
}

.tab-btn.active {
  color: var(--accent-color);
  border-bottom: 2px solid var(--accent-color);
}

/* Content Views */
.content-container {
  padding: 12px;
}

.tab-content {
  display: none;
}

.tab-content.active {
  display: block;
}

/* Football Pitch Layout */
.pitch-container {
  background: linear-gradient(180deg, #166534 0%, var(--pitch-green) 100%);
  border: 2px solid var(--pitch-lines);
  border-radius: 8px;
  padding: 16px 8px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-height: 380px;
}

.pitch-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

/* Bench Layout */
.bench-container {
  margin-top: 12px;
  background: var(--card-bg);
  padding: 12px;
  border-radius: 8px;
}

.bench-container h4 {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 8px;
}

.bench-row {
  display: flex;
  justify-content: space-around;
}

/* Player Card Component */
.player-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 60px;
  text-align: center;
}

.player-icon {
  width: 36px;
  height: 36px;
  background-color: #334155;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  margin-bottom: 4px;
  border: 1px solid #64748b;
}

.player-name {
  font-size: 10px;
  font-weight: bold;
  background: rgba(0, 0, 0, 0.7);
  padding: 2px 4px;
  border-radius: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.player-price {
  font-size: 9px;
  color: var(--text-muted);
}

/* Market & List Items */
.market-controls {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.market-controls input, .market-controls select {
  flex: 1;
  padding: 8px 12px;
  background: var(--card-bg);
  border: 1px solid #334155;
  color: var(--text-main);
  border-radius: 6px;
}

.market-item {
  background: var(--card-bg);
  padding: 10px 14px;
  border-radius: 6px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.btn-add {
  background: var(--accent-color);
  color: #000;
  border: none;
  padding: 6px 12px;
  border-radius: 4px;
  font-weight: bold;
  cursor: pointer;
}

/* Tables & Lists */
.league-card, .fixture-list {
  background: var(--card-bg);
  padding: 16px;
  border-radius: 8px;
}

.subtext {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 12px;
}

.league-table {
  width: 100%;
  border-collapse: collapse;
}

.league-table th, .league-table td {
  padding: 8px;
  text-align: left;
  border-bottom: 1px solid #334155;
}

.fixture-item {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid #334155;
  font-weight: 500;
}

.fixture-item .vs {
  color: var(--accent-color);
  font-size: 12px;
}
